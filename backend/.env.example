# Copy to .env for local development. In ECS these come from the task
# definition's environment block + Secrets Manager (see infra/cloudformation).

PORT=3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=technexus
PGUSER=technexus
PGPASSWORD=changeme
PGSSL=false

# Azure OpenAI — never commit real values. In AWS these come from
# Secrets Manager (key only) + plain task env vars (endpoint/deployment),
# injected as ECS task settings (see 03-backend-ecs.yaml).
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://kaiva-dev-az-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
