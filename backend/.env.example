# Copy to .env for local development. In ECS these come from the task
# definition's environment block + Secrets Manager (see infra/cloudformation).

PORT=3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=technexus
PGUSER=technexus
PGPASSWORD=changeme
PGSSL=false

# Real Anthropic API key — never commit this. In AWS this comes from
# Secrets Manager, injected as an ECS task secret (see 03-backend-ecs.yaml).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
